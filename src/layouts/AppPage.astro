---
// Shell for the 3D routes (/, /projects, /experience, /skills, /about). Every route mounts the same
// app with a different starting view, so deep links work on any static host (spec §3.1).
import '@fontsource/lilita-one/400.css';
import lilitaWoff2 from '@fontsource/lilita-one/files/lilita-one-latin-400-normal.woff2?url';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '../styles/tokens.css';
import '../styles/app.css';
import App from '../app/App';
import { assertValidContent } from '../content/validate';
import { portfolio } from '../content/portfolio';
import type { SectionId } from '../content/types';

interface Props {
  initial: 'island' | SectionId;
  title: string;
  description: string;
}

assertValidContent(portfolio);
const { initial, title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const { profile } = portfolio;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f6fb2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The display font sets the big name on the loading screen and island: fetch it first. -->
    <link rel="preload" href={lilitaWoff2} as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Portfolio as Markdown" />
    <link rel="alternate" type="text/html" href="/text" title="Text version" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <noscript><style>#boot { display: none; }</style></noscript>
  </head>
  <body class="app-body">
    <!-- Static copy of the loading screen, shown while the app script downloads; the app removes it
         once its own loading screen is up. -->
    <div id="boot" class="loading boot" aria-hidden="true">
      <p class="loading__name">{profile.name}</p>
      <p class="loading__sub">{profile.title}</p>
      <div class="loading__bar"><div class="loading__fill" style="transform: scaleX(0.04)"></div></div>
    </div>
    <App client:only="react" initial={initial} />
    <noscript>
      <div class="noscript">
        The 3D portfolio needs JavaScript. <a href="/text">Read the text version</a>.
      </div>
    </noscript>
  </body>
</html>
